rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function active() { return signedIn() && request.auth.token.active == true; }
    function isAdmin() { return active() && role() == 'admin'; }
    function isSupervisor() { return active() && role() == 'supervisor'; }
    function isStaffReviewer() { return isAdmin() || isSupervisor(); }

    match /users/{uid} {
      allow read: if active() && (request.auth.uid == uid || isStaffReviewer());
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    match /config/{doc} {
      allow read: if active();
      allow write: if false;
    }

    match /templateVersions/{v} {
      allow read: if active();
      allow write: if false; // publishTemplate function
    }

    match /templateDraft/{doc} {
      allow read, write: if isAdmin();
    }

    match /records/{id} {
      allow create: if active()
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.status == 'draft';

      allow read: if active() && (resource.data.technicianId == request.auth.uid || isStaffReviewer());

      allow update: if isAdmin()
        || (active() && resource.data.technicianId == request.auth.uid
            && resource.data.status in ['draft', 'returned']
            && request.resource.data.technicianId == resource.data.technicianId
            && ((resource.data.status == 'draft' && request.resource.data.status in ['draft', 'submitted'])
                || (resource.data.status == 'returned' && request.resource.data.status in ['returned', 'submitted'])))
        || (isSupervisor()
            && resource.data.status in ['submitted', 'returned']
            && request.resource.data.technicianId == resource.data.technicianId
            && request.resource.data.status in ['submitted', 'returned', 'approved']);

      allow delete: if false; // soft delete only (deleted = true, admin)

      match /history/{e} {
        allow read: if isStaffReviewer()
          || (active() && get(/databases/$(database)/documents/records/$(id)).data.technicianId == request.auth.uid);
        allow write: if false;
      }
    }

    match /auditLogs/{id} {
      allow read: if isStaffReviewer();
      allow write: if false;
    }

    match /counters/{doc} { allow read, write: if false; }
  }
}
