rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /records/{recordId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.active == true
        && (request.auth.token.role in ['supervisor', 'admin']
            || firestore.get(/databases/(default)/documents/records/$(recordId)).data.technicianId == request.auth.uid);
      allow write: if request.auth != null && request.auth.token.active == true
        && request.resource.size < 2 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*'))
        && (request.auth.token.role == 'admin'
            || firestore.get(/databases/(default)/documents/records/$(recordId)).data.technicianId == request.auth.uid);
    }
  }
}
